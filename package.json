{
  "name": "orbit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter cms dev",
    "build": "pnpm --filter cms build",
    "wp-import": "pnpm --filter cms wp-import",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint packages tools",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "1.91.0",
    "vitest": "5.1.0"
  }
}
