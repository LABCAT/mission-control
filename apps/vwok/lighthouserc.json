{
  "ci": {
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.98 }],
        "categories:best-practices": ["error", { "minScore": 0.98 }],
        "categories:performance": ["error", { "minScore": 0.98 }],
        "categories:seo": ["error", { "minScore": 0.98 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 51200 }]
      }
    },
    "collect": {
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" },
      "startServerCommand": "pnpm exec astro preview --port 4321 --host 127.0.0.1",
      "startServerReadyPattern": "127.0.0.1:4321",
      "startServerReadyTimeout": 120000,
      "url": ["http://127.0.0.1:4321/"]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
