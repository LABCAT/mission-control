---
import BaseLayout from '@mission-control/launchpad/components/BaseLayout'

import { siteTenant } from '../brand'
import BrandHead from '../components/BrandHead.astro'

type Props = {
  title: string
  description?: string
  /** Path of this page on the site; the canonical URL is built from it. */
  path?: string
  /** Error pages and previews stay out of the index. */
  noindex?: boolean
  /** Absolute share-image URL: the generated card (PJ-105). */
  image?: string
}

const { title, description, path, noindex, image } = Astro.props as Props
const siteUrl = Astro.site ? Astro.site.origin : undefined
---

<BaseLayout
  description={description}
  image={image}
  noindex={noindex}
  path={path}
  siteUrl={siteUrl}
  tenant={siteTenant}
  title={title}
>
  <BrandHead slot="head" />
  <!-- Named slots are forwarded one by one: Astro does not pass them through a wrapper. -->
  <slot name="nav" slot="nav" />
  <slot name="footer-nav" slot="footer-nav" />
  <slot />
</BaseLayout>
