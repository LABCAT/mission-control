---
/**
 * `/jobs/{slug}/apply` (PJ-45): the apply form (GET) and its no-JavaScript submit (POST, which
 * forwards to the CMS). Never cached and never indexed: it answers for whoever holds the cookie.
 * The CMS is the gate (Turnstile, rate limit, account rule); this page only shows the result.
 */
import ApplyPage from '@mission-control/launchpad/components/ApplyPage'
import { applyPath, signInPath, type ApplyFieldError } from '@mission-control/launchpad/jobs/apply'
import { isSameOriginPost } from '@mission-control/launchpad/view-as'

import NotFoundPage from '../../../components/NotFoundPage.astro'
import { applyRoute, bodyTooLarge, forwardApplication } from '../../../apply-route'
import { siteEnv } from '../../../env'
import { cmsFromEnv } from '../../../site'

export const prerender = false

const slug = Astro.params.slug ?? ''
const env = await siteEnv()
const origin = Astro.site?.origin ?? Astro.url.origin
const request = Astro.request

Astro.response.headers.set('cache-control', 'private, no-store')

const route = await applyRoute({
  cms: cmsFromEnv(env),
  cookie: request.headers.get('cookie'),
  slug,
})

let state: 'closed' | 'form' | 'sent' = 'form'
let message: string | undefined
let errors: ApplyFieldError[] = []
let values: { email?: string; message?: string; name?: string; phone?: string } = {}

if (route.kind === 'redirect') return Astro.redirect(route.location)
if (route.kind === 'not-found') Astro.response.status = 404
if (route.kind === 'closed') {
  state = 'closed'
  message = route.message
}

if (request.method === 'POST' && route.kind !== 'not-found') {
  if (!isSameOriginPost(request)) return new Response('Forbidden', { status: 403 })

  // Refuse before reading anything: a body past the cap is never parsed, cloned or forwarded.
  const parsed = bodyTooLarge(request) ? null : await request.formData().catch(() => null)

  if (!parsed) {
    state = 'form'
    message = 'The application is too large or could not be read. Files can be at most 10 MB each.'
    Astro.response.status = 413
  } else {
    // One parse serves both: what to keep on the form (files cannot be kept) and the upstream body.
    const text = (name: string) => (typeof parsed.get(name) === 'string' ? (parsed.get(name) as string) : undefined)
    values = { email: text('email'), message: text('message'), name: text('name'), phone: text('phone') }

    const outcome = await forwardApplication({
      clientAddress: Astro.clientAddress,
      env,
      form: parsed,
      jobId: route.view.detail.id,
      request,
    })

    if (outcome.kind === 'sent') {
      state = 'sent'
      values = {}
    } else if (outcome.kind === 'sign-in') {
      return Astro.redirect(signInPath(applyPath(slug)))
    } else if (outcome.kind === 'closed') {
      state = 'closed'
      message = outcome.message
    } else {
      state = 'form'
      message = outcome.message
      if (outcome.kind === 'invalid') errors = outcome.errors
      Astro.response.status = outcome.kind === 'rate-limited' ? 429 : outcome.kind === 'invalid' ? 400 : 502
    }
  }
}
---

{
  route.kind === 'not-found' ? (
    <NotFoundPage path={Astro.url.pathname} />
  ) : (
    <ApplyPage
      action={applyPath(slug)}
      errors={errors}
      jobPath={route.view.detail.url}
      jobTitle={route.view.detail.title}
      message={message}
      siteUrl={origin}
      state={state}
      tenant={route.view.tenant}
      turnstileSiteKey={env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || undefined}
      values={values}
    />
  )
}
