---
import Container from '@labcat2020/rocketship/components/Container'
import Stack from '@labcat2020/rocketship/components/Stack'
import Typography from '@labcat2020/rocketship/components/Typography'

import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout
  description="Find a job in Vanuatu: vacancies from employers in Port Vila, Luganville and across the islands."
  path="/"
  title="Find a job in Vanuatu | Vanuatu Wok"
>
  <Container size="wide">
    <Stack gap="large">
      <Typography>
        <h1>Find a job in Vanuatu</h1>
        <p>
          Vanuatu Wok is being rebuilt. Job listings, organisations and job alerts arrive in the
          next release; until then this page is the shell they will fill.
        </p>
      </Typography>
    </Stack>
  </Container>
</SiteLayout>
