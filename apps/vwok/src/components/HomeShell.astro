---
/**
 * The home page before the CMS fills it (and for a deployment with no CMS secrets). It is the
 * same hero block the site manager will edit, so the switch to CMS content changes copy only.
 */
import RenderBlocks from '@mission-control/rocketship-payload/astro/render-blocks'
import Hero from '@mission-control/rocketship-payload/astro/hero'
import type { HeroBlock } from '@mission-control/rocketship-payload/types'

import SiteLayout from '../layouts/SiteLayout.astro'
import { ogImagePath } from '../og-route'

const blocks: HeroBlock[] = [
  {
    blockType: 'hero',
    body: 'Vanuatu Wok is being rebuilt. Job listings, organisations and job alerts arrive in the next release; until then this page is the shell they will fill.',
    heading: 'Find a job in Vanuatu',
  },
]
const components = { hero: Hero }
// The shell is a shareable page too, so it points at the generated home card (PJ-105).
const image = `${Astro.site?.origin ?? Astro.url.origin}${ogImagePath({ kind: 'home' })}`
---

<SiteLayout
  description="Find a job in Vanuatu: vacancies from employers in Port Vila, Luganville and across the islands."
  image={image}
  path="/"
  title="Find a job in Vanuatu | Vanuatu Wok"
>
  <RenderBlocks blocks={blocks} components={components} />
</SiteLayout>
