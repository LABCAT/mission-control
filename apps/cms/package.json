{
  "name": "cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:tenants": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/tenants.ts",
    "seed:locations": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/locations.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation srvx --prod --dir=. --static=dist/client --entry=dist/server/server.js",
    "wp-import": "cross-env NODE_OPTIONS=--no-deprecation payload run src/wp-import.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mission-control/payload-email-cloudflare": "workspace:*",
    "@mission-control/payload-jobs": "workspace:*",
    "@mission-control/payload-wp-import": "workspace:*",
    "@payloadcms/db-postgres": "4.0.0-beta.7",
    "@payloadcms/graphql": "4.0.0-beta.7",
    "@payloadcms/plugin-multi-tenant": "4.0.0-beta.7",
    "@payloadcms/richtext-lexical": "4.0.0-beta.7",
    "@payloadcms/storage-r2": "4.0.0-beta.7",
    "@payloadcms/tanstack-start": "4.0.0-beta.7",
    "@payloadcms/transformer-sharp": "4.0.0-beta.7",
    "@payloadcms/ui": "4.0.0-beta.7",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "payload": "4.0.0-beta.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "srvx": "0.11.21",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.21",
    "typescript": "6.0.3",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
