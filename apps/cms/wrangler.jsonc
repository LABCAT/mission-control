{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mc-cms", // mission-control: own production Worker
  "main": "./src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "preview_urls": true, // mission-control: give Worker Previews a workers.dev URL for the smoke test
  // mission-control: drives Payload jobs via the scheduled() handler in src/server.ts
  "triggers": { "crons": ["0 * * * *"] },
  // Worker Previews don't inherit production bindings. Each preview gets no Hyperdrive and a
  // DATABASE_URL secret for its own Neon branch (.github/workflows/preview.yml).
  "previews": {
    "observability": { "enabled": true }
  },
  "hyperdrive": [
    {
      // Neon (direct endpoint), query caching off so the admin never reads stale data.
      "binding": "HYPERDRIVE",
      "id": "600510da0e1f45958ba5d7c908090a22", // mission-control: Hyperdrive -> Neon mission-control main
      "localConnectionString": "postgres://orbit:orbit@localhost:8900/orbit"
    }
  ],
  // mission-control: tenant content versions for cache invalidation (PJ-41). The CMS bumps a
  // version on every content write and each site reads it into its edge cache key. The id is
  // added by `wrangler deploy` on the first deploy (automatic provisioning); until then a
  // Worker with no binding simply leaves the hooks off.
  "kv_namespaces": [{ "binding": "CONTENT_CACHE" }],
  // mission-control: R2 bucket for the media and documents collections (PJ-10).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "mission-control-media" }
  ],
  // mission-control: Cloudflare Email Sending binding for the email adapter (PJ-09).
  // The sending domain is provisioned by PJ-03; until then the binding only exists here.
  "send_email": [
    { "name": "EMAIL" }
  ],
  // mission-control: rate limit for the account auth endpoints (PJ-81): 10 requests per minute
  // per key. namespace_id only has to be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "ACCOUNT_RATE_LIMIT", "namespace_id": "8100", "simple": { "limit": 10, "period": 60 } }
  ]
}
