DATABASE_URL=postgres://orbit:orbit@localhost:8900/orbit
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Bindings (not variables): `MEDIA` is an R2 bucket declared in wrangler.jsonc. `pnpm dev` and the
# tests use wrangler's local R2 automatically, so there is nothing to set here.

# Xero add-on (PJ-55/PJ-57). Optional locally: without them Xero stays unconnected and orders are
# not invoiced. In production these are Worker secrets (`wrangler secret put`), never committed.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=http://localhost:<port>/api/xero/callback
# Base64 of 32 random bytes (`generateEncryptionKey()` in payload-xero). Rotating it disconnects
# every tenant.
# XERO_TOKEN_ENCRYPTION_KEY=
# Optional: HMAC key for the OAuth state; defaults to PAYLOAD_SECRET.
# XERO_STATE_SECRET=

# Email safety (PJ-94). Redirect-all is ON unless ENVIRONMENT=production: every email goes to
# EMAIL_REDIRECT_TO with the original recipients in the subject. With no inbox set, nothing is
# delivered (console). In Cloudflare, set ENVIRONMENT=production on the production Worker only,
# and EMAIL_REDIRECT_TO as a secret/variable on previews. Never commit a real address.
# EMAIL_REDIRECT_TO=
# ENVIRONMENT=production

# Turnstile for public form submissions (PJ-102) and job applications (PJ-45). Optional locally:
# without it POST /api/tenants/:slug/forms/submit and POST /api/jobs/:id/apply answer
# form_not_configured / apply_not_configured. In production set it as a
# Worker secret (`wrangler secret put TURNSTILE_SECRET_KEY`), never committed.
# TURNSTILE_SECRET_KEY=
