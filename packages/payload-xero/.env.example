# Xero app credentials (OAuth2 authorization code flow, confidential client).
# Create the app at https://developer.xero.com; the redirect URI must match exactly.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://cms.example.com/api/xero/callback

# AES-256-GCM key for tokens at rest: base64 of 32 random bytes.
# Generate once per environment with `generateEncryptionKey()` and keep it in a secret store.
# Rotating it disconnects every tenant (their stored tokens stop decrypting).
XERO_TOKEN_ENCRYPTION_KEY=

# The signed OAuth `state` uses PAYLOAD_SECRET when XERO_STATE_SECRET is unset.
# XERO_STATE_SECRET=
