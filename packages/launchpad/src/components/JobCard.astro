---
import JobCardBody from './JobCardBody.astro'
import type { JobSummary } from '../types'

type Props = {
  job: JobSummary
  /** Tenant locale, for money and dates. */
  locale?: string
  /** Tenant timezone, for dates. */
  timezone?: string
  /** Labels in the tenant's language. */
  closesLabel?: string
  featuredLabel?: string
  volunteerLabel?: string
}

// The script below is what makes this card an island. A page that must ship no client JS — a
// CMS page with a latest-jobs block — renders `JobCardBody` instead.
const props = Astro.props as Props
---

<JobCardBody {...props} viewedSlot />

<script>
  import { has } from '../viewed-jobs'
  import { whenIdle } from '../viewed-jobs/idle'

  const revealViewed = (): void => {
    for (const card of document.querySelectorAll<HTMLElement>('[data-job-id]')) {
      const jobId = card.dataset.jobId
      if (!jobId || !has(jobId)) continue

      const label = card.querySelector<HTMLElement>('[data-viewed-label]')
      if (!label) continue
      label.classList.add('lp-job__viewed--shown')
      label.removeAttribute('aria-hidden')
    }
  }

  whenIdle(revealViewed)
</script>
