---
import Card from '@labcat2020/rocketship/components/Card'

import type { OrgSummary } from '../types'

type Props = {
  org: OrgSummary & { initials?: string; sizeLabel?: string; typeLabel?: string }
  /** Label for the job count, e.g. `open jobs`. */
  jobsLabel?: string
}

const { org, jobsLabel = 'open jobs' } = Astro.props as Props
const hasJobs = typeof org.jobCount === 'number'
---

<Card as="article">
  {
    org.logo?.url ? (
      // Lazy, with its intrinsic size so the card never shifts while the logo loads. The name is
      // the link text, so the logo is decorative.
      <img
        slot="media"
        class="rs-card__media"
        src={org.logo.url}
        alt=""
        loading="lazy"
        decoding="async"
        width={org.logo.width ?? undefined}
        height={org.logo.height ?? undefined}
      />
    ) : (
      org.initials && (
        <span slot="media" class="lp-org__initials" aria-hidden="true">
          {org.initials}
        </span>
      )
    )
  }
  <h3 class="rs-card__title">
    <a class="rs-card__link" href={org.url}>{org.name}</a>
  </h3>
  {org.description && <p class="rs-card__description">{org.description}</p>}
  {
    (org.location || org.typeLabel || org.sizeLabel || hasJobs) && (
      <ul class="lp-org__facts">
        {org.typeLabel && <li>{org.typeLabel}</li>}
        {org.sizeLabel && <li>{org.sizeLabel}</li>}
        {org.location && <li>{org.location}</li>}
        {hasJobs && (
          <li>
            {org.jobCount} {jobsLabel}
          </li>
        )}
      </ul>
    )
  }
</Card>

<style>
  .lp-org__initials {
    align-items: center;
    aspect-ratio: 16 / 9;
    background: var(--rs-color-surface-muted, var(--rs-color-surface));
    color: var(--rs-color-muted);
    display: flex;
    font-size: var(--rs-font-size-xl, 1.5rem);
    font-weight: 600;
    justify-content: center;
    width: 100%;
  }

  .lp-org__facts {
    color: var(--rs-color-muted);
    display: flex;
    flex-wrap: wrap;
    gap: var(--rs-space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
