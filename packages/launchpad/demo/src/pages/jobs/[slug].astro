---
/**
 * `/jobs/{slug}` in the demo: built from `loadJobDetail`, the same loader a site app calls, so
 * the page exercises the real state rules (live, expired notice, 410 Gone) and the real mapping.
 */
import JobDetailPage from '../../../../src/components/JobDetailPage.astro'
import { demoJobDetail } from '../../listing'
import { detailJobs, tenant } from '../../data'

export function getStaticPaths() {
  return detailJobs.map((job) => ({ params: { slug: job.slug } }))
}

const slug = Astro.params.slug ?? ''
const result = await demoJobDetail(slug)

// A 410 page is the site's own; the demo has no body for it beyond this marker.
if (!result.found || result.status === 'gone') {
  return new Response('Gone', { status: result.found ? 410 : 404 })
}

const siteUrl = new URL(Astro.request.url).origin
---

<JobDetailPage
  applyHref={`/jobs/${encodeURIComponent(slug)}/apply`}
  image={`${siteUrl}/og/jobs/${encodeURIComponent(slug)}.png`}
  locale="en"
  siteUrl={siteUrl}
  tenant={tenant}
  view={result.view}
  viewEndpoint="/api/jobs/view"
/>
