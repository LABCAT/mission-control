---
/**
 * The demo's section routes: `/jobs/category/:slug` and `/jobs/type/:slug`. One file dispatches
 * through `jobListingRoute`, the same helper a site app uses, so the demo proves the mapping as
 * well as the render. A static demo only generates the sections the tenant has; a site app builds
 * the same route at request time and turns an unknown slug into a 404.
 */
import JobsPage from '../../../../src/components/JobsPage.astro'
import { jobListingRoute } from '../../../../src/jobs/listing'
import { demoListing } from '../../listing'
import { facets, tenant } from '../../data'

export const getStaticPaths = () => [
  ...facets.categories.map((category) => ({ params: { path: `category/${category.slug}` } })),
  ...facets.types.map((type) => ({ params: { path: `type/${type.slug}` } })),
]

const route = jobListingRoute(`/jobs/${Astro.params.path ?? ''}`)
if (!route) throw new Error(`demo: not a listing path: ${Astro.params.path}`)

const definition =
  facets.categories.find((category) => category.slug === route.locked.category) ??
  facets.types.find((type) => type.slug === route.locked.type)

const view = await demoListing({ basePath: route.basePath, locked: route.locked, search: Astro.url.search })
---

<JobsPage
  description={`${definition?.name ?? 'Jobs'} in Vanuatu.`}
  path={route.basePath}
  tenant={tenant}
  title={`${definition?.name ?? 'Jobs'} jobs`}
  view={view}
/>
