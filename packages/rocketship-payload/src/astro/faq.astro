---
import Container from '@labcat2020/rocketship/components/Container'
import Disclosure from '@labcat2020/rocketship/components/Disclosure'
import Stack from '@labcat2020/rocketship/components/Stack'
import Typography from '@labcat2020/rocketship/components/Typography'

import './blocks.css'
import { lexicalToHtml } from '../richtext'
import type { FaqBlock } from '../types'

type Props = {
  block: FaqBlock
}

const { block } = Astro.props
---

<section class="rp-block">
  <Container size="content">
    <Stack gap="large">
      {
        block.heading && (
          <Typography>
            <h2>{block.heading}</h2>
          </Typography>
        )
      }
      <div class="rp-faq__list">
        {
          block.items.map((item) => (
            <Disclosure>
              <span slot="summary">{item.question}</span>
              <Typography html={lexicalToHtml(item.answer)} />
            </Disclosure>
          ))
        }
      </div>
    </Stack>
  </Container>
</section>
